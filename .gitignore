# ---------------------------------------------------------------
# Saikoro Bay .gitignore
# ---------------------------------------------------------------

# Godot 4 (keep *.import and *.uid files: they belong in the repo)
.godot/
/android/
export_credentials.cfg
*.translation
mono_crash.*.json

# OS files
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Editors and IDEs
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.swp
*.swo
*~
*.sublime-workspace

# AI assistant files, prompts and local-only notes (kept out of the repo)
CLAUDE.md
CLAUDE.local.md
.claude/
prompts/
*.prompt.md
notes/
docs/

# Secrets and local env
.env
.env.*
!.env.example
*.pem
*.key

# Logs and temp files
*.log
*.tmp
*.bak
tmp/
temp/

# Build output (build/.gdignore stays, so Godot never imports exports)
build/*
!build/.gdignore
builds/
dist/
export/
exports/

# Adult art never enters git (the repo is public). It lives only on the
# maintainer's PC, with backups; full builds are made there. CI and every
# clone see SFW content only. Source art lives outside the repo entirely.
content/adult/*
!content/adult/README.md
!content/adult/ci_canary/
art-src/
