extends SceneTree
## Writes tests/golden/fights.json from the current fight rules. Run it on
## a known-good main, never to make a failing refactor pass:
##
##   godot --headless --path . -s res://tools/make_golden_fights.gd


func _initialize() -> void:
	var data: GameData = GameData.load_dir()
	if not data.is_valid():
		printerr("\n".join(data.errors))
		quit(2)
		return
	var records: Array = []
	for case: Dictionary in GoldenFights.cases(data):
		records.append(GoldenFights.play(data, case))
	var file: FileAccess = FileAccess.open(GoldenFights.PATH, FileAccess.WRITE)
	file.store_string("{\n\t\"schema\": 1,\n\t\"note\": \"Golden fights: see tests/golden/golden_fights.gd. Generated by tools/make_golden_fights.gd.\",\n\t\"fights\": [\n")
	for i: int in records.size():
		file.store_string("\t\t" + JSON.stringify(records[i], "", false) + ("," if i < records.size() - 1 else "") + "\n")
	file.store_string("\t]\n}\n")
	file.close()
	print("wrote %d fights to %s" % [records.size(), GoldenFights.PATH])
	quit(0)
