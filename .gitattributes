# Normalize line endings: text files are stored with LF in the repo.
* text=auto eol=lf

# Godot text resources (always LF, diff as text)
*.gd      text eol=lf
*.tscn    text eol=lf
*.tres    text eol=lf
*.godot   text eol=lf
*.import  text eol=lf
*.uid     text eol=lf
*.cfg     text eol=lf
*.svg     text eol=lf
*.json    text eol=lf

# Godot binary resources
*.res  binary
*.scn  binary
*.pck  binary
*.tpz  binary

# Windows-only scripts keep CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Images
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.bmp       binary
*.tga       binary
*.ico       binary
*.psd       binary
*.kra       binary
*.aseprite  binary
*.ase       binary
*.clip      binary

# Audio
*.wav   binary
*.ogg   binary
*.mp3   binary
*.flac  binary

# Video
*.mp4   binary
*.webm  binary
*.mov   binary

# Fonts
*.ttf    binary
*.otf    binary
*.woff   binary
*.woff2  binary

# 3D and archives
*.blend  binary
*.fbx    binary
*.glb    binary
*.zip    binary
*.7z     binary

# ---------------------------------------------------------------
# Git LFS: large source files for art, audio, fonts and video.
# Git for Windows ships with Git LFS; run `git lfs install` once per
# machine. Game-ready images and audio (png, ogg) stay in plain Git
# while they are small placeholders; move them here if they grow.
# ---------------------------------------------------------------
*.psd       filter=lfs diff=lfs merge=lfs -text
*.kra       filter=lfs diff=lfs merge=lfs -text
*.clip      filter=lfs diff=lfs merge=lfs -text
*.aseprite  filter=lfs diff=lfs merge=lfs -text
*.ase       filter=lfs diff=lfs merge=lfs -text
*.wav       filter=lfs diff=lfs merge=lfs -text
*.flac      filter=lfs diff=lfs merge=lfs -text
*.mp4       filter=lfs diff=lfs merge=lfs -text
*.mov       filter=lfs diff=lfs merge=lfs -text
*.webm      filter=lfs diff=lfs merge=lfs -text
*.blend     filter=lfs diff=lfs merge=lfs -text
*.otf       filter=lfs diff=lfs merge=lfs -text
*.ttf       filter=lfs diff=lfs merge=lfs -text

# Vendored plugins (GUT's fonts) stay in plain Git, so CI and fresh clones
# work without fetching LFS objects.
addons/**/*.ttf  -filter -diff -merge binary
addons/**/*.otf  -filter -diff -merge binary
