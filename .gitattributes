# Normalize line endings: text files are stored with LF in the repo.
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Images
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.bmp       binary
*.tga       binary
*.ico       binary
*.psd       binary
*.kra       binary
*.aseprite  binary
*.ase       binary
*.clip      binary

# Audio
*.wav   binary
*.ogg   binary
*.mp3   binary
*.flac  binary

# Video
*.mp4   binary
*.webm  binary
*.mov   binary

# Fonts
*.ttf    binary
*.otf    binary
*.woff   binary
*.woff2  binary

# 3D and archives
*.blend  binary
*.fbx    binary
*.glb    binary
*.zip    binary
*.7z     binary

